# Set a real key outside Git: openssl rand -base64 32
AUTH_SIGNING_KEY=
AUTH_DB_PATH=private/auth.db
LISTEN_ADDR=127.0.0.1:8080
# Explicit origins only; empty disables browser-origin access, not mobile clients.
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765

# Optional loopback-only local vision worker
LOCAL_VISION_URL=http://127.0.0.1:8091/analyze
